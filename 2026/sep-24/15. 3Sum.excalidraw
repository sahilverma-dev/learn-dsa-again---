      "isDeleted": false,
      "boundElements": null,
      "updated": 1790585188131,
      "link": null,
      "locked": false,
      "text": "if threeSum>0\n    r-=1\nelif threeSum<0\n    l+=1\nelse\n    ans.append([nums[i], nums[l], nums[r]])\n    l+=1\n    \n    while nums[l] == nums[l - 1] and l < r:\n        l += 1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if threeSum>0\n    r-=1\nelif threeSum<0\n    l+=1\nelse\n    ans.append([nums[i], nums[l], nums[r]])\n    l+=1\n    \n    while nums[l] == nums[l - 1] and l < r:\n        l += 1",
      "autoResize": true,
      "lineHeight": 1.25
